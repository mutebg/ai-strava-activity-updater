{
  "name": "ai-activity-updater-functions",
  "version": "1.0.0",
  "description": "Firebase Functions AI tool for analyzing and updating Strava activities",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "test": "tsx --test test/*.test.ts"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@genkit-ai/google-genai": "^1.44.0",
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0",
    "genkit": "^1.44.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
